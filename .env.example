# Credentials (required, no defaults)
ROOT_PASS=
DB_USER_PASS=
ZNUNY_ADMIN_PASS=

# Database settings
DB_HOST=znuny-db
DB_NAME=znuny
DB_USER=znuny

# Resource limits
ZNUNY_DAEMON_MEMLIMIT=2048m
ZNUNY_DAEMON_CPUS=2
ZNUNY_HTTPD_MEMLIMIT=1024m
ZNUNY_HTTPD_CPUS=2
ZNUNY_DB_MEMLIMIT=2048m
ZNUNY_DB_CPUS=2

# MariaDB
MARIADB_VERSION=11.4.7

# Web server
external_port=80
DEFAULT_INTERFACE=agent

# Container registry
# CONTAINER_REGISTRY=znuny                                     # default (local build)
# CONTAINER_REGISTRY=ghcr.io/znuny                             # GitHub Container Registry
# CONTAINER_REGISTRY=registry.gitlab.com/znuny/znuny-docker    # GitLab Container Registry
CONTAINER_REGISTRY=znuny
ZNUNY_IMAGE_TAG=latest

# Traefik (only needed with docker-compose.traefik.yml)
ZNUNY_DOMAIN=znuny.example.com
ACME_EMAIL=admin@example.com
